PORT=3333
# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-unico
# String de conexão do Postgres (local, Neon, Supabase, etc.)
DATABASE_URL=postgres://usuario:senha@localhost:5432/imobiliaria
# URL(s) do front-end que podem chamar esta API (CORS). Aceita uma lista separada por vírgula.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
